# Server
PORT=3000

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/atiq-engineering
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atiq-engineering
MONGODB_URI=mongodb://127.0.0.1:27017/atiq-engineering

# Secret used to sign admin JWT sessions. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret

# Admin dashboard login.
# Generate ADMIN_PASSWORD_HASH with: node server/generate-admin-hash.js "YourStrongPassword123"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-generated-bcrypt-hash

# Optional: restrict CORS to a specific origin in production (e.g. https://atiqengineering.com)
CORS_ORIGIN=
